---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Scanner from '../components/Scanner.astro';
import { isStaff } from '../lib/auth';
import { getDb } from '../lib/db';
import { totalEmployers } from '../lib/employers';
import { sessionSecret } from '../lib/env';

const env = Astro.locals.runtime.env;
const secret = sessionSecret(env);
if (!(await isStaff(Astro.request, secret))) {
  return Astro.redirect(`/staff?next=${encodeURIComponent('/chocolate')}`, 302);
}

const startOfDay = new Date();
startOfDay.setUTCHours(0, 0, 0, 0);
const db = getDb(env);
const stats = await db
  .prepare(
    `SELECT
       (SELECT COUNT(*) FROM redemptions) AS total,
       (SELECT COUNT(*) FROM redemptions WHERE redeemed_at >= ?) AS today`,
  )
  .bind(startOfDay.toISOString())
  .first<{ total: number; today: number }>();

const total = Number(stats?.total ?? 0);
const today = Number(stats?.today ?? 0);
---

<Base title="Chocolate counter" description="Verify all seven stands before handing over the chocolate." noindex>
  <div class="shell stack stack-lg">
    <header class="spread">
      <div class="row" style="gap: 1rem">
        <span class="choc-mark" aria-hidden="true"><Icon name="chocolate" size={26} /></span>
        <div class="stack stack-sm">
          <span class="eyebrow" style="color: var(--choc-500)">Reward desk</span>
          <h1>Chocolate counter</h1>
          <p class="muted tiny">{totalEmployers} stands must be ticked before a bar is handed over.</p>
        </div>
      </div>
      <div class="row">
        <a class="btn btn-ghost btn-sm" href="/staff">
          <Icon name="users" size={16} />
          Staff desk
        </a>
        <form method="post" action="/api/staff/logout">
          <button class="btn btn-ghost btn-sm" type="submit">
            <Icon name="logout" size={16} />
            Lock
          </button>
        </form>
      </div>
    </header>

    <div class="choc-grid">
      <Scanner mode="redeem" accent="#7b4526" />

      <aside class="stack stack-md">
        <section class="card card-pad choc-banner stack stack-sm">
          <div class="row" style="justify-content: space-between; align-items: flex-start">
            <span class="eyebrow" style="color: #f0c98a">Today</span>
            <span class="chip chip-lime">Free</span>
          </div>
          <h2 class="big-number">{today}</h2>
          <p class="muted tiny">chocolate bar{today === 1 ? '' : 's'} handed out today · {total} in total</p>
          <div class="progress" style="background: rgba(255,255,255,.16)">
            <span style="width: 100%; background: linear-gradient(90deg,#d9a44a,#f0c98a)"></span>
          </div>
        </section>

        <section class="card card-pad stack stack-sm">
          <span class="eyebrow">The rule</span>
          <h3>All seven, or no bar</h3>
          <p class="muted tiny">
            The scanner checks the visitor’s record in real time. If a stand is missing, it lists exactly which
            ones — send them back to finish the lap.
          </p>
          <p class="tiny muted">
            A pass can only be redeemed once. Repeat scans show the original redemption time, so a queue can move
            quickly without double-giving.
          </p>
        </section>
      </aside>
    </div>
  </div>
</Base>

<style>
  .choc-grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: start;
  }

  .choc-mark {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: linear-gradient(135deg, #4a2716, #7b4526);
    color: #f7d9b6;
    box-shadow: 0 12px 24px -14px rgba(74, 39, 22, 0.9);
  }

  h1 {
    font-size: clamp(1.9rem, 3.4vw, 2.7rem);
  }

  .big-number {
    font-size: 3rem;
    line-height: 1;
    color: #fff4e4;
  }

  @media (max-width: 900px) {
    .choc-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
